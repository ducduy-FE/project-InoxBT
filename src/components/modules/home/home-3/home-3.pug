            div(class='img-ratio ratio:pt-[850_720] rem:h-[720px]')
              img(src="./img/1.jpg" alt="" class='lozad object-cover')
      .swiper-pagination
      .bg-title-service
        .title-service
          h1(class='absolute -top-5 left-1/2 -translate-x-1/2 bg-primary-1 rounded-2 p-2 text-center') something
          .flex.flex-col.gap-5.pt-5.w-full
            -for(let i = 0; i < 4; i++ )
              p something
