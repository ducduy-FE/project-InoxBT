    h1.text-h1.font-bold Dich vu
  .flex
    div(class='bg-primary-1 lg:rem:w-[calc(480/1920*100rem)] md:flex hidden xl:px-15 px-4  items-center text-white ') 
      h1.text-h1.font-bold Dich vu
    .swiper.swiper-service.group(class='-sm:w-1/2')
      .swiper-wrapper
        -for(let i = 0; i < 6; i++)
