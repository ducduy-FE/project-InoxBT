header
  .header
    a(href="/") 
      img(src="./img/logo.png" alt="" class='lozad') 
    nav(class='flex gap-base')
    ul(class=' xl:flex hidden gap-14 justify-between items-center pr-0 2xl:px-19')
      li
        a.item-navbar(href="/") Trang chủ 
      li
        a.item-navbar(href="/") Giới thiệu
      li
        a.item-navbar(href="/") 
          | Thép không rỉ 
          <i class="fa-solid fa-caret-down ml-2"></i>
      li
        a.item-navbar(href="/") Dịch vụ 
      li
        a.item-navbar(href="/") Tin tức 
      li
        a.item-navbar(href="/") Hỗ trợ 
      li
        a.item-navbar(href="/") Liên hệ
    ul(class='flex gap-5 items-center justify-end xl:pr-0 pr-5 ')
      li#searchBox(class='sm:flex hidden items-center border rounded-2 overflow-hidden text-gray-700 text-base px-4 py-2 space-x-3 border-gray-700')
        i#searchIcon(class='fa-regular fa-magnifying-glass cursor-pointer')
        input#searchInput(type='text' placeholder='Tìm kiếm' class='flex-1 focus:outline-none hidden md:block')
      li(class='relative sm:flex hidden gap-3 items-center text-base') 
        <i class="fa-light fa-globe text-primary-1"></i>
        div
          //- Nút chính
          a#langToggle(href='javascript:void(0)' class='flex items-center')
            span VN
            i.fa-solid.fa-caret-down.ml-2

          //- Dropdown
          ul#langMenu(class='absolute right-0 mt-1 -translate-x-1 hidden w-full bg-white border rounded-md shadow-md z-50')
            li.langHeader(class='flex justify-center -translate-x-1er items-center gap-2 px-3 py-2 hover:bg-gray-100 cursor-pointer') VN
            li.langHeader(class='flex justify-center items-center gap-2 px-3 py-2 hover:bg-gray-100 cursor-pointer') EN
      include ./HeaderHambuger
  .header-moblie