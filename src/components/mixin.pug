mixin subscribeForm()
	.subscribe
		.subscribefrm
			input.subscribeemail(type="text" placeholder="Nhập email của bạn...")
			button.subscribebutton Gửi
mixin PugImg(url="./img/1.jpg")
	img(data-src=url, alt="" class="lozad " + attributes.class)
mixin btnViewAll(text="Xem thêm")
	a(href="" x-link class='btn-primary-2 btn ' + attributes.class)
		span=text
		img(src=imgButton, alt="" class="w-5 h-5 svg")
mixin HeaderLanguageVertical()
	ul 
		li.wpml-ls-item
			a(href="") 
				span.wpml-ls-native VN
				<i class="fa-solid fa-caret-down ml-3"></i>
	ul 
		li 
			a(href="") 
				span EN
				<i class="fa-solid fa-caret-down ml-3"></i>

mixin HeaderLanguageHorizontal()
	ul 
		li.wpml-ls-item
			a(href="") 
				span.wpml-ls-native VN
		li.wpml-ls-item
			a(href="") 
				span.wpml-ls-native EN
mixin BtnPrimary(text="")
	a(href="" class='btn-primary btn ' + attributes.class)
		span=text
mixin HeaderMenu()
	.header-menu 
		ul 
			-var menu = ['Giới thiệu','Sản phẩm','Dự án', 'Dịch vụ','Thông tin','Tuyển dụng']
			each item in menu
				li.menu-item-has-children
					a(href="")=item
mixin HeaderLanguage()
	.header-language 
		.header-language-active
			ul 
				li.wpml-ls-current-language
					a(href="") 
						span.wpml-ls-native VN
				ul 
					li 
						a(href="") 
							span EN
		.header-language-list
			ul 
				li.wpml-ls-current-language
					a(href="") 
						span.wpml-ls-native VN
				ul 
					li 
						a(href="") 
							span EN
mixin Breadcrumb-custom(items)
	.flex.items-center(class="" + attributes.class)
		each item, i in items
			- const isLast = i === items.length - 1
			- const isFirst = i === 0
			p(
				class=[
					'px-2 py-0', 
					'body-18',
					isFirst ? 'pl-15' : '',
					isLast ? 'font-bold text-primary-1' : 'font-normal text-gray-700'
				]
			)= item
			if !isLast
				//- thanh ngăn cách ngắn giữa các phần tử
				span(class="inline-block w-[1px] h-[13px] bg-gray-400 rounded mx-1")

mixin BtnOutline(title)
	a.btn-outline(href="/")= title 
mixin BtnPrimary(title)
	a.btn-primary(href="/")= title 
mixin btn-number(title, active = false)
	- const activeClass = active ? 'bg-primary-1 text-white' : 'bg-transparent border-primary-1 text-gray-500 hover:text-white hover:bg-primary-1 duration-300'
	.btn.btn-number(class=`w-12 h-12 border flex justify-center items-center rounded-2 cursor-pointer ${activeClass}`)
		p.title-20.font-bold= title